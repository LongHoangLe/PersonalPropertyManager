<Window x:Class="PersonalPropertyManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PersonalPropertyManager.ViewModels"
        xmlns:conv="clr-namespace:PersonalPropertyManager.Converters"
        xmlns:models="clr-namespace:PersonalPropertyManager.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Personal Property Manager"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:ImagePathToBitmapConverter x:Key="ImagePathToBitmapConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:NullToVisibilityInverseConverter x:Key="NullToVisibilityInverseConverter" />
        <conv:CurrencyConverter x:Key="CurrencyConverter" />
        <conv:DesireStatusToTextConverter x:Key="DesireStatusToTextConverter" />
        <conv:DesireStatusToBrushConverter x:Key="DesireStatusToBrushConverter" />
        <conv:ItemTypeToTextConverter x:Key="ItemTypeToTextConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- toolbar -->
            <RowDefinition Height="*" />
            <!-- main split -->
            <RowDefinition Height="Auto" />
            <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Personal Property Manager"
                           FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <Button Content="+ Add New" Command="{Binding AddNewCommand}" Margin="0,0,6,0" />
                <Button Content="Save" Command="{Binding SaveCommand}" Margin="0,0,6,0" />
                <Button Content="Delete" Command="{Binding DeleteCommand}"
                        Style="{StaticResource DangerButton}" Margin="0,0,12,0" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" />
                <Button Content="Browse Image…" Command="{Binding BrowseImageCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                <Button Content="Remove Image" Command="{Binding RemoveImageCommand}"
                        Style="{StaticResource SecondaryButton}" />
            </StackPanel>
        </Border>

        <!-- Main split: list (left) | editor (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="400" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: filter + list -->
            <Grid Grid.Column="0" Margin="12,12,6,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filter bar -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Search"
                                   FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="12,0,0,4">
                            <Run Text="Total: " />
                            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="   Value: " />
                            <Run Text="{Binding TotalValue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                 FontWeight="Bold" />
                        </TextBlock>

                        <Grid Grid.Row="1" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search by name, description, notes, or location" />

                            <ComboBox Grid.Column="1" Width="140" Margin="6,0,0,0"
                                      ToolTip="Filter by item type"
                                      ItemsSource="{Binding ItemTypes}"
                                      SelectedItem="{Binding SelectedType}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource ItemTypeToTextConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ComboBox Grid.Column="2" Width="120" Margin="6,0,0,0"
                                      ToolTip="Filter by desire status"
                                      ItemsSource="{Binding DesireStatuses}"
                                      SelectedItem="{Binding SelectedStatus}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource DesireStatusToTextConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Grid.Column="3" Content="Search" Margin="6,0,0,0"
                                    Command="{Binding SearchCommand}" />
                            <Button Grid.Column="3" Content="Clear" Margin="6,0,0,0"
                                    Command="{Binding ClearFiltersCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" Text="Items" FontWeight="SemiBold" Margin="2,0,0,4" />

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding FilteredProperties}"
                          SelectedItem="{Binding SelectedProperty}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding ItemType}" Width="120" />
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding DesireStatus, Converter={StaticResource DesireStatusToTextConverter}}"
                                            Width="90" />
                        <DataGridTextColumn Header="Value"
                                            Binding="{Binding CurrentValue, Converter={StaticResource CurrencyConverter}}"
                                            Width="100" />
                        <DataGridTextColumn Header="Location"
                                            Binding="{Binding Location}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          Background="Transparent" ShowsPreview="False" />

            <!-- RIGHT: detail editor -->
            <Grid Grid.Column="2" Margin="6,12,12,12">
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Item details" FontSize="15" FontWeight="Bold"
                                   Margin="0,0,0,12" />

                        <!-- Empty-state message -->
                        <TextBlock Grid.Row="1"
                                   Text="Select an item from the list, or click '+ Add New' to create one."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding SelectedProperty, Converter={StaticResource NullToVisibilityInverseConverter}}" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding SelectedProperty, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel DataContext="{Binding SelectedProperty}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="220" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#FFF1F5F9"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Margin="0,0,12,12">
                                        <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathToBitmapConverter}}"
                                               Stretch="Uniform" />
                                    </Border>

                                    <Border Grid.Column="1" Width="140" Margin="0,0,0,12"
                                            Background="#FFF8FAFC"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4"
                                            Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Quick actions" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <Button Content="Browse…" Command="{Binding DataContext.BrowseImageCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="Remove"
                                                    Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <GroupBox Header="Identity">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" />
                                        <TextBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                                  Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Type" VerticalAlignment="Center" Margin="0,8,0,0" />
                                        <ComboBox  Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                                                   ItemsSource="{Binding DataContext.AllItemTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   SelectedItem="{Binding ItemType}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource ItemTypeToTextConverter}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Desire status" VerticalAlignment="Center" Margin="12,8,0,0" />
                                        <ComboBox  Grid.Row="1" Grid.Column="3" Margin="0,8,0,0"
                                                   ItemsSource="{Binding DataContext.AllDesireStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   SelectedItem="{Binding DesireStatus}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource DesireStatusToTextConverter}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Value &amp; dates">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Current value (USD)" VerticalAlignment="Center" />
                                        <TextBox  Grid.Row="0" Grid.Column="1"
                                                  Text="{Binding CurrentValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource CurrencyConverter}}" />

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Acquired" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <DatePicker Grid.Row="0" Grid.Column="3"
                                                    SelectedDate="{Binding AcquiredDate}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Location" VerticalAlignment="Center" Margin="0,8,0,0" />
                                        <TextBox  Grid.Row="1" Grid.Column="1"
                                                  Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Updated" VerticalAlignment="Center" Margin="12,8,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,8,0,0"
                                                   Text="{Binding UpdatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Description (work experiences, skills, notes)">
                                    <StackPanel>
                                        <TextBlock Text="Describe the item, work experiences with it, skills it supports, etc."
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="0,0,0,6" />
                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="100" VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top" />

                                        <TextBlock Text="Free-form notes" FontWeight="SemiBold" Margin="0,12,0,4" />
                                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="60" VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top" />
                                    </StackPanel>
                                </GroupBox>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="Save" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" />
                <TextBlock Grid.Column="1" Foreground="{StaticResource MutedTextBrush}">
                    <Run Text="DB: " />
                    <Run Text="SQLite (app.db next to the .exe)" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
